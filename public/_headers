# 1-year immutable caching for Vite hashed assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static public assets caching
/logo.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/icons.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Direct APK download routing and mime-type
/downloads/*
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="spendr.apk"
  Cache-Control: public, max-age=86400

# HTML never cached so updates deploy immediately
/*
  Cache-Control: public, max-age=0, must-revalidate

